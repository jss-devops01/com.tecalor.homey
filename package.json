{
  "name": "com.tecalor.homey",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "lint": "eslint --ext .js,.ts --ignore-path .gitignore .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathIgnorePatterns=/integration/",
    "test:integration": "node run-integration-tests.js",
    "test:integration:quick": "node run-integration-tests.js --quick",
    "test:integration:skip": "SKIP_INTEGRATION_TESTS=true jest --testPathPattern=integration",
    "test-connection": "npm run build ; node test-connection.js"
  },
  "dependencies": {
    "@2colors/esphome-native-api": "^1.3.3",
    "@stablelib/base64": "^1.0.1",
    "@stablelib/chacha20poly1305": "^1.0.1"
  },
  "devDependencies": {
    "@tsconfig/node16": "^16.1.5",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.5.2",
    "eslint": "^7.32.0",
    "eslint-config-athom": "^3.1.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.2"
  }
}
